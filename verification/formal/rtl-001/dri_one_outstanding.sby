[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 40

[engines]
smtbmc boolector

[script]
# `formal_top` now instantiates the real dfc_rtl001 (see
# dri_one_outstanding_formal.sv's own header for the full history of how
# this file reached its current form). This means sby must now read
# dfc_rtl001's real dependencies too, not just the formal harness file --
# the error this section previously produced ("Module `dfc_rtl001' ...
# is not part of the design") was exactly this: [files] only listed the
# harness itself, so sby never copied/read RTL-001 or its packages at all.
# Read order matters (packages before what references their symbols),
# same order used throughout this project's build/sim scripts.
#
# dfc_types_pkg.sv added here after a second, real, confirmed gap of the
# exact same shape: dfc_rtl001.sv gained real `rtl002_control_o`/
# `rtl002_status_i`/`status_o` ports this session, sized via
# `dfc_types_pkg::DFC_RTL002_CONTROL_WIDTH` etc. -- real, plain VALUE
# constants (safe per PROJECT_CONTINUITY.md Section 2's pkg::VALUE-vs-
# pkg::TYPE finding), but this harness's own [files]/[script] never read
# that package, so Yosys had no idea what those constants meant --
# confirmed via a real sby run: "ERROR: Non-constant range in declaration
# of \rtl002_control_o". RTL-001 never referenced dfc_types_pkg at all
# before this session's RTL-002 integration work, which is exactly why
# this harness's file list never needed it until now.
read -formal dfc_constants_pkg.sv
read -formal dfc_types_pkg.sv
read -formal dfc_registers_pkg.sv
read -formal dfc_config_regbank_regs.sv
read -formal dfc_rtl001.sv
read -formal dri_one_outstanding_formal.sv
prep -top formal_top

[files]
../../../include/dfc_constants_pkg.sv
../../../include/dfc_types_pkg.sv
../../../include/dfc_registers_pkg.sv
../../../rtl/infrastructure/generated/dfc_config_regbank_regs.sv
../../../rtl/infrastructure/src/dfc_rtl001.sv
dri_one_outstanding_formal.sv

# --- HISTORY: how this file reached its current form -----------------
# Multiple real toolchain findings were needed before this ran cleanly,
# each confirmed by an actual sby/yosys run, not assumed:
#   1. `default clocking`/`default disable iff` -- fails to parse under
#      both Icarus and Yosys's native frontend. Fixed by giving each
#      property its own explicit clocking clause.
#   2. Yosys's native frontend cannot parse concurrent SVA
#      (`assert property`, |->, |=>) at all -- confirmed on two Yosys
#      versions three years apart.
#   3. `read_slang` (tried as a fix for #2) parses the syntax correctly,
#      but the Yosys-slang plugin does not yet translate |-> / |=> into
#      checkable formal properties -- confirmed directly via a real
#      design.log: "error: encountered unsupported SVA feature."
#   4. dri_one_outstanding_formal.sv rewritten to use immediate assertions
#      instead of concurrent ones (see that file's own header for the full
#      per-property translation, including one property --
#      P_EXACTLY_ONE_RSP -- deliberately dropped as genuinely redundant
#      once expressed this way, not silently lost). Confirmed to parse
#      cleanly and produce real $assert cells under Yosys's native
#      frontend, so `read -formal` is used, with no dependency on
#      read_slang.
#   5. `formal_top` updated to instantiate the REAL dfc_rtl001 (it was a
#      signal-only stub through finding #4; RTL-001 is now real, tested,
#      and synthesis-verified, so the stub is no longer needed for 4 of
#      the 5 properties). This required adding RTL-001's own real
#      dependencies to [files]/[script] above. One property
#      (P_WRITE_COMMIT_SAME_CYCLE_AS_OK) remains bound to a free input --
#      see that property's own comment in dri_one_outstanding_formal.sv
#      for the specific, confirmed reason (a hierarchical reference into
#      the DUT's internal signal does not resolve under Yosys's native
#      frontend).
#   6. dfc_types_pkg.sv added to [script]/[files] after a real, confirmed
#      run ("ERROR: Non-constant range in declaration of
#      \rtl002_control_o") -- dfc_rtl001.sv gained real ports this
#      session sized via dfc_types_pkg:: VALUE constants (RTL-002
#      register-bus integration), and this harness's file list had never
#      needed that package before, so it was never added. NOT
#      independently re-tested against a real `sby` run at the time this
#      fix was written (no SymbiYosys available in that sandbox) -- this
#      is a plausible, well-grounded fix (identical in kind to the same
#      package being added to build_ecp5.ps1's source list earlier this
#      session for the identical reason), not a confirmed one. Treat the
#      next real `formal.ps1` run as this fix's actual first test.
#
# `formal_top` now binds against the REAL RTL-001 DRI endpoint for 4 of 5
# properties -- passing/failing against it is a genuine statement about
# RTL-001's actual behavior for those 4, not merely self-consistency of an
# isolated stub.
