BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# ulx3s_dfc.lpf -- Dragon Core skeleton HIL bring-up constraints.
#
# Every LOCATE/IOBUF line below is transcribed exactly from the real board
# constraint file (emard/ulx3s, doc/constraints/ulx3s_v20.lpf, v2.x.x/v3.0.x),
# fetched directly rather than recalled from memory -- restricted to only
# the pins this specific design (ulx3s_dfc_top.sv) actually uses.

# ---- 25 MHz onboard oscillator (real board file, "usb"/"gpdi" sheet) ----
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# JTAG/SPI flash voltage config (real board file, verbatim)
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

# ---- SPI host interface: J1 header, individual (non-vector) gp0-gp4 ----
# (real board file's "GPIO repeated as individual signals" section)
# gp0=SCLK(in) gp1=CS_N(in) gp2=MOSI(in) gp3=MISO(tristate) gp4=host_irq_n(out)
LOCATE COMP "gp0" SITE "B11";
LOCATE COMP "gp1" SITE "A10";
LOCATE COMP "gp2" SITE "A9";
LOCATE COMP "gp3" SITE "B9";
LOCATE COMP "gp4" SITE "A7";
IOBUF PORT "gp0" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp1" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp2" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp3" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp4" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- GPIO Controller (RTL-006): J1 gp5-gp7 + J2 gp22-gp26, single-ended-
# only positions (real board file, "GPIO repeated as individual signals"
# section) -- gp5=ch0 gp6=ch1 gp7=ch2 gp22=ch3 gp23=ch4 gp24=ch5 gp25=ch6
# gp26=ch7. Each is a real bidirectional pin (see ulx3s_dfc_top.sv's own
# tristate wiring); gp27 is left unassigned as a spare single-ended-only
# position for a future module.
LOCATE COMP "gp5" SITE "C8";
LOCATE COMP "gp6" SITE "C6";
LOCATE COMP "gp7" SITE "A6";
LOCATE COMP "gp22" SITE "B15";
LOCATE COMP "gp23" SITE "B17";
LOCATE COMP "gp24" SITE "C16";
LOCATE COMP "gp25" SITE "D14";
LOCATE COMP "gp26" SITE "B13";
IOBUF PORT "gp5" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp6" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp7" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp22" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp23" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp24" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp25" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp26" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- Rotor RPM Monitor (RTL-007): J2 gp27, tachometer/RPM pulse input.
# Real board file, "GPIO repeated as individual signals" section. This is
# the last remaining single-ended-only position (see
# ULX3S_CONNECTION_MAP.md's own Section 4/6 for the exhaustion note) --
# any future module needing a pin must use the differential-capable range.
LOCATE COMP "gp27" SITE "D13";
IOBUF PORT "gp27" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- Engine RPM Monitor (RTL-008): J1 gp8, tachometer/RPM pulse input.
# Real board file (emard/ulx3s, doc/constraints/ulx3s_v20.lpf), "DIFF"-
# tagged differential-capable section -- the single-ended-only range having
# been fully exhausted by RTL-007 (see ULX3S_CONNECTION_MAP.md's own
# Section 4/7 for the exhaustion note). gp8/gn8 carry no wifi-sharing
# comment in the real board file (unlike gp11-gp13), confirmed free; used
# here as an ordinary single-ended input per ULX3S's own manual ("DIFF
# pairs can be used also as single-ended pins"). gn8 (SITE A5) is now
# assigned too, as RTL-016's own safety_out_o[0] -- see this file's own
# Safety Output Controller section below and ULX3S_CONNECTION_MAP.md's
# Section 10. This makes gn8 unavailable for a true LVDS pair with gp8 if
# that range is ever needed for real differential signaling later.
LOCATE COMP "gp8" SITE "A4";
IOBUF PORT "gp8" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- Pulse/Frequency Measurement (RTL-009): J1 gp9/gp10, two tachometer/
# pulse-frequency inputs sharing one logical 2-bit pulse_i port. Real board
# file (emard/ulx3s, doc/constraints/ulx3s_v20.lpf), "DIFF"-tagged
# differential-capable section, positions immediately following RTL-008's
# gp8 -- confirmed free via a direct curl+grep of the real raw file content
# against the exact "gp9"/"gn9"/"gp10"/"gn10" LOCATE lines (and the
# surrounding gp11-gp13/gn11-gn13 lines, to directly confirm which nearby
# positions carry the wifi-sharing comment and which don't): gp9/gp10 carry
# no wifi-sharing comment (unlike gp11-gp13's "wifi_gpio26"/"wifi_gpio33"/
# "wifi_gpio35"), confirmed free. Used here as ordinary single-ended inputs
# per ULX3S's own manual ("DIFF pairs can be used also as single-ended
# pins"), same precedent as gp8 above -- no differential signal involved.
# pulse_i[0]=gp9 (channel 0), pulse_i[1]=gp10 (channel 1). gn9 (SITE B1)
# and gn10 (SITE B4) are now assigned too, as RTL-016's own
# safety_out_o[1]/[2] -- see this file's own Safety Output Controller
# section below and ULX3S_CONNECTION_MAP.md's Section 10. This makes
# gn9/gn10 unavailable for a true LVDS pair with gp9/gp10 respectively,
# same disclosed consequence as gp8/gn8 above.
LOCATE COMP "gp9" SITE "A2";
LOCATE COMP "gp10" SITE "C4";
IOBUF PORT "gp9" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp10" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- System Health Monitor (RTL-011): J2 gp14-gp21, 8 real external
# health-discrete inputs. Real board file (emard/ulx3s,
# doc/constraints/ulx3s_v20.lpf), "DIFF"-tagged differential-capable
# section -- confirmed free via a direct curl+grep of the real raw file
# content against the exact "gp14".."gp21" LOCATE lines: none of the eight
# carry a wifi-sharing comment (unlike gp11-gp13's "wifi_gpio26"/
# "wifi_gpio33"/"wifi_gpio35"). This is the ENTIRE remaining unshared
# differential-capable range -- chosen over the numerically-earlier but
# WiFi-shared gp11-gp13, same "prefer unshared over shared" precedent
# RTL-009 already established, and it happens to exactly and completely
# exhaust what was left. After this module, gp11-gp13 (WiFi-shared) are
# the only differential-capable positions still open -- see
# ULX3S_CONNECTION_MAP.md's own new Section 9 for the full accounting.
# Each is a plain single-ended input (no tristate) -- dfc_rtl011.sv owns
# its own real two-flop CDC-HEALTH synchronizer per channel.
# health_i[0]=gp14 health_i[1]=gp15 health_i[2]=gp16 health_i[3]=gp17
# health_i[4]=gp18 health_i[5]=gp19 health_i[6]=gp20 health_i[7]=gp21
LOCATE COMP "gp14" SITE "U18";
LOCATE COMP "gp15" SITE "N17";
LOCATE COMP "gp16" SITE "N16";
LOCATE COMP "gp17" SITE "L16";
LOCATE COMP "gp18" SITE "H18";
LOCATE COMP "gp19" SITE "F17";
LOCATE COMP "gp20" SITE "D18";
LOCATE COMP "gp21" SITE "C18";
IOBUF PORT "gp14" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp15" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp16" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp17" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp18" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp19" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp20" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gp21" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- Safety Output Controller (RTL-016): gn8/gn9/gn10/gn14, 4 real
# external safety-output pads. Real board file (emard/ulx3s,
# doc/constraints/ulx3s_v20.lpf) -- confirmed via a direct curl+grep of the
# raw file content against the exact "gn8"/"gn9"/"gn10"/"gn14" LOCATE
# lines: none of the four carry a wifi-sharing comment. These are the
# "orphaned" differential-pair counterparts of gp8 (RTL-008), gp9/gp10
# (RTL-009), and gp14 (RTL-011) respectively -- each gp<N> partner is
# already committed to an ordinary single-ended signal of its own, so its
# gn<N> half was left genuinely unassigned and electrically free (ULX3S's
# own manual: "differential pairs can be used also as single-ended pins"),
# per ULX3S_CONNECTION_MAP.md's own Sections 7/8/9 notes. Chosen over the
# WiFi-shared gp11-gp13/gn11-gn13 range (the only differential-capable
# positions left after this module) to avoid touching the shared positions
# before RTL-017/019/020 (which will each need real pins of their own) --
# see ULX3S_CONNECTION_MAP.md's own new Section 10 for the full
# accounting. Pure outputs (no PULLMODE, matching this file's own Debug
# LEDs convention below): safety_out_o[0]=gn8, [1]=gn9, [2]=gn10, [3]=gn14.
LOCATE COMP "gn8"  SITE "A5";
LOCATE COMP "gn9"  SITE "B1";
LOCATE COMP "gn10" SITE "B4";
LOCATE COMP "gn14" SITE "U17";
IOBUF PORT "gn8"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn9"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn10" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn14" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# ---- ARINC 429 Receive (RTL-017/RTL-024 adapter): gn15/gn16, 2 real
# external input pads -- arinc_rx_i (line data, already digital per
# ARCH-BUS-001's own "assumes an external line-transceiver IC already
# converts BPRZ to NRZ" scope note) and arinc_rx_adapter_error_i (the
# transceiver's own fault output). Real board file SITEs per this file's
# own "gn14-gn21 (SITEs U17/P16/M17/L17/H17/G18/E17/D17)" accounting
# (ULX3S_CONNECTION_MAP.md Section 10) -- gn14=U17 already used above by
# RTL-016, so gn15=P16, gn16=M17 are the next two in that same fixed
# site ordering, "exhaust unshared, lowest-numbered first" per this
# project's established pin-choice rule. Pure inputs, pulled up so an
# unconnected/not-yet-wired transceiver reads idle-high rather than a
# floating value (same PULLMODE=UP convention as gp27/gp14-21 above).
LOCATE COMP "gn15" SITE "P16";
LOCATE COMP "gn16" SITE "M17";
IOBUF PORT "gn15" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "gn16" PULLMODE=UP IO_TYPE=LVCMOS33;

# ---- ARINC 429 Transmit (RTL-018): gn17/gn18/gn19, 3 real pads -- 2
# outputs (arinc_tx_ctrl_o[1:0]) and 1 input (arinc_tx_adapter_error_i, the
# transmit transceiver's own fault output). Real board file SITEs per this
# file's own established "gn14-gn21 (SITEs U17/P16/M17/L17/H17/G18/E17/D17)"
# accounting (ULX3S_CONNECTION_MAP.md Section 10) -- gn15/gn16=P16/M17
# already used above by RTL-017, so gn17=L17, gn18=H17, gn19=G18 are the
# next three in that same fixed site ordering, "exhaust unshared,
# lowest-numbered first" per this project's established pin-choice rule.
# arinc_tx_ctrl_o is a pure output (no PULLMODE, matching this file's own
# Debug LEDs/Safety Output convention); arinc_tx_adapter_error_i is a pure
# input, pulled up so an unconnected/not-yet-wired transceiver reads
# idle-high rather than floating (same PULLMODE=UP convention as gn15/gn16
# above).
LOCATE COMP "gn17" SITE "L17";
LOCATE COMP "gn18" SITE "H17";
LOCATE COMP "gn19" SITE "G18";
IOBUF PORT "gn17" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn18" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "gn19" PULLMODE=UP IO_TYPE=LVCMOS33;

# ---- Debug LEDs (real board file, "blinkey"/"gpio" sheet) ----
# led[0]/led[1] are meaningfully driven (pll_locked/por_n) by this design;
# led[2:7] are tied zero in ulx3s_dfc_top.sv but still need pin constraints
# since they are real physical output pins.
LOCATE COMP "led[7]" SITE "H3";
LOCATE COMP "led[6]" SITE "E1";
LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[4]" SITE "D1";
LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[0]" SITE "B2";
IOBUF PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
